[Unit]
Description=MongoDB instance for Naruto Mythos (port 27018, replica set rs0)
After=network-online.target
Wants=network-online.target

[Service]
User=mongodb
Group=mongodb
Type=simple
ExecStart=/usr/bin/mongod --config /etc/mongod-naruto.conf
LimitFSIZE=infinity
LimitCPU=infinity
LimitAS=infinity
LimitNOFILE=64000
LimitNPROC=64000
LimitMEMLOCK=infinity
TasksMax=infinity
TasksAccounting=false
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
