generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                      String               @id @default(auto()) @map("_id") @db.ObjectId
  username                String               @unique
  email                   String               @unique
  password                String               @default("")
  elo                     Int                  @default(500)
  wins                    Int                  @default(0)
  losses                  Int                  @default(0)
  draws                   Int                  @default(0)
  discordId               String?
  discordUsername         String?
  discordHighestElo       Int                  @default(0)
  role                    String               @default("user")
  badgePrefs              String[]             @default([])
  animationsEnabled       Boolean              @default(true)
  soundsEnabled           Boolean              @default(true)
  gameBackground          String               @default("default")
  resetToken              String?
  resetTokenExpiry        DateTime?
  emailBase               String?
  emailVerifiedAt         DateTime?
  createdAt               DateTime             @default(now())
  decks                   Deck[]
  gamesAsPlayer1          Game[]               @relation("Player1")
  gamesAsPlayer2          Game[]               @relation("Player2")
  friendshipsSent         Friendship[]         @relation("FriendshipSent")
  friendshipsReceived     Friendship[]         @relation("FriendshipReceived")
  matchInvitesSent        MatchInvite[]        @relation("MatchInviteSent")
  matchInvitesReceived    MatchInvite[]        @relation("MatchInviteReceived")
  eloHistory              EloHistory[]
  accounts                Account[]
  tournamentWins          Int                  @default(0)
  chatBanned              Boolean              @default(false)
  chatBanUntil            DateTime?
  gameBanned              Boolean              @default(false)
  gameBanUntil            DateTime?
  allowSpectatorHand      Boolean              @default(false)
  consecutiveWins         Int                  @default(0)
  consecutiveLosses       Int                  @default(0)
  evolvingElo             Int                  @default(500)
  evolvingGamesPlayed     Int                  @default(0)
  evolvingWins            Int                  @default(0)
  evolvingLosses          Int                  @default(0)
  evolvingDraws           Int                  @default(0)
  unlockedVariantCardIds  String[]             @default([])
  battlepassXp            Int                  @default(0)
  battlepassTier          Int                  @default(0)
  infiniteBoostersGranted Int                  @default(0)
  unopenedBoosters        BoosterInventory[]
  questProgresses         QuestProgress[]
  dailyQuestProgresses    DailyQuestProgress[]
  stripeCustomerId        String?
  hideDeckBuilderVariants Boolean              @default(false)
  countryCode             String?
  chatVisibility          String               @default("everyone")
  fastAnimations          Boolean              @default(false)
  chatIntroSeenAt         DateTime?
  usernameResetRequired   Boolean              @default(false)

  @@index([elo])
  @@index([createdAt])
  @@index([evolvingElo])
}

model BoosterInventory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  setId     String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, setId])
  @@index([userId])
}

model QuestProgress {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId     String
  progress    Int       @default(0)
  target      Int
  completed   Boolean   @default(false)
  completedAt DateTime?
  claimed     Boolean   @default(false)
  claimedAt   DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, questId])
  @@index([userId, completed, claimed])
}

model DailyQuestAssignment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      String   @unique
  questId   String
  createdAt DateTime @default(now())
}

model DailyQuestProgress {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String
  questId     String
  progress    Int       @default(0)
  target      Int
  completed   Boolean   @default(false)
  completedAt DateTime?
  claimed     Boolean   @default(false)
  claimedAt   DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, date])
  @@index([userId, claimed])
}

/// Per-game ELO snapshot. Survives the Game row purge (72h) up to 14 days so
/// admins can audit a player's recent ELO trajectory even after the source
/// Game has been deleted. Purged by cleanupOldEloHistory in lib/db/gameCleanup.ts.
model EloHistory {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId           String?  @db.ObjectId // may be null after the Game is purged
  opponentId       String?  @db.ObjectId // nullable: opponent account might be deleted
  opponentUsername String // duplicated so the row is self-describing
  opponentElo      Int // opponent ELO at the time the game finished
  oldElo           Int // this user's ELO BEFORE the game
  newElo           Int // this user's ELO AFTER the game
  delta            Int // newElo - oldElo (signed)
  result           String // "win" | "loss" | "draw"
  myScore          Int // mission points scored by this user
  opponentScore    Int // mission points scored by the opponent
  isRanked         Boolean  @default(true)
  eloType          String   @default("ranked")
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([userId, eloType, createdAt])
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Deck {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  userId             String   @db.ObjectId
  user               User     @relation(fields: [userId], references: [id])
  cardIds            String[]
  missionIds         String[]
  sortOrder          Int      @default(0)
  evolvingPoints     Int      @default(0)
  evolvingCompatible Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, evolvingPoints])
  @@index([userId, evolvingCompatible])
}

model DeckStats {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  deckId       String   @unique @db.ObjectId
  userId       String   @db.ObjectId
  wins         Int      @default(0)
  losses       Int      @default(0)
  draws        Int      @default(0)
  eloDeltaSum  Int      @default(0)
  lastPlayedAt DateTime
  dailyGz      Bytes?
  updatedAt    DateTime @updatedAt

  @@index([userId, lastPlayedAt])
}

model Game {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  player1Id    String?   @db.ObjectId
  player2Id    String?   @db.ObjectId
  player1      User?     @relation("Player1", fields: [player1Id], references: [id])
  player2      User?     @relation("Player2", fields: [player2Id], references: [id])
  isAiGame     Boolean   @default(false)
  aiDifficulty String?
  status       String
  winnerId     String?   @db.ObjectId
  gameState    Json?
  gameStateGz  Bytes?
  player1Score Int       @default(0)
  player2Score Int       @default(0)
  eloChange    Int?
  isEvolving   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([status, completedAt])
  @@index([player1Id, completedAt])
  @@index([player2Id, completedAt])
  @@index([isEvolving, completedAt])
}

model Room {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  code       String   @unique
  hostId     String   @db.ObjectId
  guestId    String?  @db.ObjectId
  gameId     String?  @db.ObjectId
  status     String
  isPrivate  Boolean  @default(false)
  isEvolving Boolean  @default(false)
  holoHue    Int?
  createdAt  DateTime @default(now())
}

model Friendship {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String   @db.ObjectId
  receiverId String   @db.ObjectId
  sender     User     @relation("FriendshipSent", fields: [senderId], references: [id])
  receiver   User     @relation("FriendshipReceived", fields: [receiverId], references: [id])
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([senderId, receiverId])
}

model MatchInvite {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String   @db.ObjectId
  receiverId String   @db.ObjectId
  sender     User     @relation("MatchInviteSent", fields: [senderId], references: [id])
  receiver   User     @relation("MatchInviteReceived", fields: [receiverId], references: [id])
  roomCode   String?
  status     String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
}

model BannedCard {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  cardId   String   @unique
  reason   String?
  bannedAt DateTime @default(now())
}

model SiteSettings {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  key            String  @unique
  leaguesEnabled Boolean @default(false)
  sealedEnabled  Boolean @default(false) @map("draftEnabled")
  discordRoleIds Json?
}

model Tournament {
  id                 String                  @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  type               String                  @default("simulator")
  format             String                  @default("swiss")
  status             String
  gameMode           String
  maxPlayers         Int
  currentRound       Int                     @default(0)
  totalRounds        Int                     @default(0)
  isPublic           Boolean                 @default(true)
  joinCode           String?                 @unique
  creatorId          String                  @db.ObjectId
  creatorUsername    String
  requiresDiscord    Boolean                 @default(true)
  useBanList         Boolean                 @default(true)
  sealedBoosterCount Int?
  sealedSetChoice    String?
  discordRoleReward  String?
  discordRoleBadge   String?
  bannedCardIds      String[]                @default([])
  allowedLeagues     String[]                @default([])
  // Restricted mode constraints (gameMode = "restricted")
  allowedGroups      String[]                @default([]) // e.g. ["Leaf Village","Sand Village"] — empty = all allowed
  bannedGroups       String[]                @default([]) // e.g. ["Akatsuki"]
  allowedKeywords    String[]                @default([]) // e.g. ["Team 7"] — empty = all allowed
  bannedKeywords     String[]                @default([]) // e.g. ["Summon","Rogue Ninja"]
  allowedRarities    String[]                @default([]) // e.g. ["C","UC","R"] — empty = all allowed
  bannedRarities     String[]                @default([]) // e.g. ["S","M"]
  maxPerRarity       Json? // e.g. {"R":4,"S":2} — max cards per rarity
  maxCopiesPerCard   Int? // override default 2 copies limit
  minDeckSize        Int? // override default 30
  maxDeckSize        Int? // optional max deck size
  maxChakraCost      Int? // max individual card chakra cost
  restrictionNote    String? // free-text note shown to players
  prizeCardId        String? // Phase 6: tournament winner prize card (KS-108-MV / KS-120-MV / KS-128-MV / KS-137-MV)
  scheduledStartAt   DateTime?
  matchTimeLimitMs   Int                     @default(1800000)
  joinTimeLimitMs    Int                     @default(300000)
  startedAt          DateTime?
  completedAt        DateTime?
  winnerId           String?                 @db.ObjectId
  winnerUsername     String?
  createdAt          DateTime                @default(now())
  participants       TournamentParticipant[]
  matches            TournamentMatch[]

  @@index([status, createdAt])
  @@index([status, scheduledStartAt])
  @@index([creatorId])
}

model TournamentParticipant {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  tournamentId    String     @db.ObjectId
  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId          String     @db.ObjectId
  username        String
  seed            Int?
  eliminated      Boolean    @default(false)
  eliminatedRound Int?
  hasBye          Boolean    @default(false)
  sealedPool      Json?
  sealedDeck      Json?
  deckId          String?    @db.ObjectId // Selected deck for classic/restricted modes
  deckValid       Boolean    @default(false) // Whether selected deck passes tournament rules
  joinedAt        DateTime   @default(now())

  @@unique([tournamentId, userId])
}

model TournamentMatch {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  tournamentId    String     @db.ObjectId
  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  bracket         String     @default("main")
  round           Int
  matchIndex      Int
  player1Id       String?    @db.ObjectId
  player2Id       String?    @db.ObjectId
  player1Username String?
  player2Username String?
  winnerId        String?    @db.ObjectId
  winnerUsername  String?
  isBye           Boolean    @default(false)
  status          String
  roomCode        String?
  gameId          String?    @db.ObjectId
  absenceDeadline DateTime?
  absentPlayerId  String?    @db.ObjectId
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())

  @@unique([tournamentId, bracket, round, matchIndex])
}

model TournamentAdminLog {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  tournamentId   String   @db.ObjectId
  actorId        String   @db.ObjectId
  actorUsername  String
  action         String
  targetUserId   String?  @db.ObjectId
  targetUsername String?
  matchId        String?  @db.ObjectId
  details        Json?
  createdAt      DateTime @default(now())

  @@index([tournamentId, createdAt])
}

model CardIssue {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  cardIds     String[] // Array of card IDs sharing the same issue
  cardNames   String[] // Parallel array of card names
  description String
  status      String   @default("to_fix") // to_fix | fixed_unpublished | fixed_published | verified
  reportedBy  String
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  roomCode    String
  userId      String   @db.ObjectId
  username    String
  message     String
  isEmote     Boolean  @default(false)
  isSpectator Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ChatReport {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  messageId        String
  reporterId       String    @db.ObjectId
  reporterName     String
  targetId         String    @db.ObjectId
  targetName       String
  messageText      String
  roomCode         String
  reason           String    @default("")
  status           String    @default("pending")
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?
  resolvedBy       String?
  action           String?
  reporterNotified Boolean   @default(false)
  reporterReward   Int?
}

model UserBlock {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  blockerId String   @db.ObjectId
  blockedId String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model PrivateMessage {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  threadKey  String
  senderId   String    @db.ObjectId
  receiverId String    @db.ObjectId
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([threadKey, createdAt])
  @@index([receiverId, readAt])
  @@index([createdAt])
}

model PlayerReport {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  reporterId        String    @db.ObjectId
  reporterName      String
  targetId          String    @db.ObjectId
  targetName        String
  reason            String
  context           String
  roomCode          String?
  attachedMessage   String?
  attachedMessageAt DateTime?
  status            String    @default("pending")
  resolvedBy        String?   @db.ObjectId
  resolvedAt        DateTime?
  sanctionId        String?   @db.ObjectId
  createdAt         DateTime  @default(now())

  @@index([status, createdAt])
  @@index([targetId])
}

model Sanction {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  username     String
  type         String
  reason       String
  reportId     String?   @db.ObjectId
  issuedBy     String    @db.ObjectId
  issuedByName String
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model PlayerNotification {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  kind      String
  payload   Json
  seenAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, seenAt])
  @@index([createdAt])
}

model UserBan {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  username  String
  type      String
  permanent Boolean   @default(false)
  expiresAt DateTime?
  reason    String    @default("")
  issuedBy  String    @db.ObjectId
  createdAt DateTime  @default(now())
}

model Donation {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  stripeSessionId      String?   @unique
  stripeSubscriptionId String?
  stripeCustomerId     String?
  stripeInvoiceId      String?   @unique
  stripeChargeId       String?   @unique
  userId               String?   @db.ObjectId
  userEmail            String?
  username             String?
  amountCents          Int
  currency             String    @default("eur")
  mode                 String
  status               String
  isRecurring          Boolean   @default(false)
  paidAt               DateTime?
  createdAt            DateTime  @default(now())
  cancelledAt          DateTime?
  refundedAt           DateTime?
  failureReason        String?
  thankYouMailSentAt   DateTime?

  @@index([status, createdAt])
  @@index([isRecurring, status])
  @@index([userId, createdAt])
  @@index([stripeSubscriptionId])
  @@index([createdAt])
}

model Suggestion {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  username  String
  category  String
  title     String
  body      String
  status    String    @default("open")
  voteCount Int       @default(0)
  adminNote String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  votes SuggestionVote[]

  @@index([status, voteCount])
  @@index([status, createdAt])
  @@index([category, status])
  @@index([userId, createdAt])
}

model AdminAction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId   String   @db.ObjectId
  actorName String
  action    String
  targetId  String?  @db.ObjectId
  payload   Json?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

model SuggestionVote {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  suggestionId String   @db.ObjectId
  userId       String   @db.ObjectId
  createdAt    DateTime @default(now())

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, userId])
  @@index([userId])
}

model VariantInventory {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  cardId String
  count  Int    @default(1)

  @@unique([userId, cardId])
  @@index([userId])
}

model TradeRoom {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  creatorId    String    @db.ObjectId
  guestId      String    @db.ObjectId
  status       String    @default("pending")
  creatorOffer String[]  @default([])
  guestOffer   String[]  @default([])
  creatorReady Boolean   @default(false)
  guestReady   Boolean   @default(false)
  completedAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([creatorId])
  @@index([guestId])
  @@index([status, createdAt])
}

model TradeLog {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  tradeRoomId   String   @db.ObjectId
  senderId      String   @db.ObjectId
  receiverId    String   @db.ObjectId
  senderCards   String[]
  receiverCards String[]
  executedAt    DateTime @default(now())

  @@index([senderId, executedAt])
  @@index([receiverId, executedAt])
}

model ChatModerationScan {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  messageId   String
  roomCode    String
  userId      String
  username    String
  message     String
  provider    String
  categories  Json
  topCategory String
  topScore    Float
  action      String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

model EmailVerification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  email      String   @unique
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  sentCount  Int      @default(1)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
}

model CountryGroupStat {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  countryCode String
  group       String
  day         String
  count       Int    @default(0)

  @@unique([countryCode, group, day])
  @@index([day])
}

model CardUsageStat {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  cardId    String   @unique
  count     Int      @default(0)
  rate      Float    @default(0)
  tier      String   @default("NU")
  updatedAt DateTime @updatedAt
}

model CardUsageMeta {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  key           String    @unique @default("singleton")
  totalDecks    Int       @default(0)
  activePlayers Int       @default(0)
  computedAt    DateTime  @default(now())
  firstDataAt   DateTime?
}

model CardUsageDay {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  date   String
  cardId String
  decks  Int    @default(0)

  @@unique([date, cardId])
  @@index([date])
}

model CardUsageDayTotal {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  date  String @unique
  decks Int    @default(0)
  games Int    @default(0)
}

model Survey {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String?
  status        String    @default("open")
  createdBy     String
  createdAt     DateTime  @default(now())
  closedAt      DateTime?
  questions     Json
  responseCount Int       @default(0)

  @@index([status, createdAt])
  @@index([createdAt])
}

model SurveyResponse {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  surveyId  String
  userId    String
  username  String
  answers   Json
  createdAt DateTime @default(now())

  @@unique([surveyId, userId])
  @@index([surveyId])
}

model CardGameStat {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  groupKey      String   @unique
  gamesSeen     Int      @default(0)
  gamesWon      Int      @default(0)
  timesPlayed   Int      @default(0)
  timesRevealed Int      @default(0)
  timesUpgraded Int      @default(0)
  copiesSum     Int      @default(0)
  copyDecks     Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model CardStatsCursor {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  key        String   @unique @default("singleton")
  lastGameAt DateTime @default(now())
}

model UserModeStat {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  mode      String
  games     Int      @default(0)
  wins      Int      @default(0)
  losses    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, mode])
  @@index([userId])
}
