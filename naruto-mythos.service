[Unit]
Description=Naruto Mythos Game
Requires=docker.service
After=docker.service

[Service]
Type=simple
Restart=always
RestartSec=5
WorkingDirectory=/home/naruto-mythos/naruto-game
ExecStartPre=-/usr/bin/docker rm -f naruto-mythos
ExecStart=/usr/bin/docker run \
  --name naruto-mythos \
  -p 3000:3000 \
  -e NODE_ENV=production \
  -e PORT=3000 \
  -e HOSTNAME=0.0.0.0 \
  -e DATABASE_URL=mongodb+srv://dlkdigitalagency_db_user:***REDACTED***@cluster0.q4izgvf.mongodb.net/naruto-mythos-tcg?appName=Cluster0 \
  -e NEXTAUTH_SECRET=***REDACTED*** \
  -e NEXTAUTH_URL=https://narutomythosgame.com \
  -e NEXT_PUBLIC_SOCKET_URL= \
  naruto-game-app
TimeoutStopSec=330
ExecStop=/usr/bin/docker stop -t 310 naruto-mythos
ExecStopPost=/usr/bin/docker rm -f naruto-mythos

[Install]
WantedBy=multi-user.target
